# ============================================
# ANVAYA Server — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env     (macOS/Linux)
#   copy .env.example .env   (Windows)
#
# NEVER commit .env to Git — it contains secrets!
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials.
# Example: mongodb+srv://myuser:mypass@anvaya-cluster.abc123.mongodb.net/anvaya
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/anvaya?retryWrites=true&w=majority

# JWT Secret — use a strong, random string (at least 32 characters)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# JWT token expiration
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
